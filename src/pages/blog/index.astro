---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = "Blog — Tovar Belgisi va Patent Bo'yicha Maqolalar | IPNishon";
const description = "Tovar belgisini ro'yxatdan o'tkazish, Nitsa klassifikatsiyasi, Madrid tizimi va patentlash bo'yicha foydali maqolalar va qo'llanmalar.";

const dateFmt = (d: Date) => d.toLocaleDateString('uz-UZ', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={title} description={description}>
  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">BLOG</p>
        <h1>Tovar belgisi va patent bo'yicha maqolalar</h1>
        <p>Ro'yxatdan o'tkazish jarayoni, narxlar, xalqaro himoya va eng ko'p uchraydigan xatolar haqida amaliy qo'llanmalar.</p>
      </div>
      <div class="post-list">
        {posts.map(post => (
          <a class="post-row" href={`/blog/${post.id}/`}>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
              {post.data.tags[0] && <span class="tag">{post.data.tags[0]}</span>}
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-list{ display:flex; flex-direction:column; border-top:1px solid var(--line); }
  .post-row{ display:block; padding-block:28px; border-bottom:1px solid var(--line); text-decoration:none; color:inherit; }
  .post-meta{ display:flex; gap:12px; align-items:center; font-family:var(--mono); font-size:12px; color:var(--ink-faint); margin-bottom:10px; }
  .post-row h2{ font-size:22px; margin-bottom:8px; transition:color 0.15s ease; }
  .post-row:hover h2{ color:var(--brass-deep); }
  .post-row p{ color:var(--ink-soft); font-size:15px; max-width:65ch; }
</style>
