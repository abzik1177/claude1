---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services.ts';
import { serviceDetails } from '../../data/serviceDetails.ts';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return services.map(s => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const detail = serviceDetails[service.slug];
const allPosts = await getCollection('blog');
const related = detail.relatedPosts
  .map(id => allPosts.find(p => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const title = `${service.title} | IPNishon`;
const description = service.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: service.title,
  provider: { '@type': 'LegalService', name: 'IPNishon' },
  areaServed: 'UZ',
  description: service.description,
};
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section>
    <div class="wrap-narrow">
      <p class="crumbs"><a href="/">Bosh sahifa</a> / <a href="/xizmatlar/">Xizmatlar</a> / {service.title}</p>
      <h1>{service.title}</h1>
      <p class="lead">{detail.intro}</p>

      <h2>Kimlarga kerak?</h2>
      <ul class="plain-list">
        {detail.whoFor.map(item => <li>{item}</li>)}
      </ul>

      <h2>Jarayon</h2>
      <div class="steps">
        {detail.steps.map((s, i) => (
          <div class="step">
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{s.title}</h3><p>{s.desc}</p></div>
          </div>
        ))}
      </div>

      <h2>Ko'p so'raladigan savollar</h2>
      <div class="faqs">
        {detail.faqs.map(f => (
          <div class="faq">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>

      {related.length > 0 && (
        <>
          <h2>Shu mavzuda maqolalar</h2>
          <ul class="plain-list">
            {related.map(p => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>)}
          </ul>
        </>
      )}

      <div class="cta-box">
        <p>{service.title} bo'yicha bepul konsultatsiya oling</p>
        <a href="/aloqa/" class="btn btn-primary">Bog'lanish</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  section{ padding-block:56px 88px; }
  h1{ font-size:clamp(28px,4vw,42px); line-height:1.15; }
  .lead{ margin-top:20px; font-size:17px; color:var(--ink-soft); }
  h2{ font-size:24px; margin-top:48px; margin-bottom:20px; }
  .plain-list{ display:flex; flex-direction:column; gap:10px; padding-left:20px; color:var(--ink-soft); font-size:15px; }
  .plain-list a{ color:var(--brass-deep); text-decoration:underline; text-underline-offset:2px; }
  .steps{ display:flex; flex-direction:column; gap:22px; }
  .step{ display:flex; gap:18px; align-items:flex-start; }
  .step-num{ font-family:var(--mono); font-size:14px; color:var(--brass-deep); padding-top:2px; }
  :root[data-theme="dark"] .step-num{ color:var(--brass); }
  .step h3{ font-size:16px; margin-bottom:4px; }
  .step p{ font-size:14.5px; color:var(--ink-soft); }
  .faqs{ display:flex; flex-direction:column; gap:20px; }
  .faq{ border-top:1px solid var(--line); padding-top:16px; }
  .faq h3{ font-size:15.5px; margin-bottom:8px; }
  .faq p{ font-size:14.5px; color:var(--ink-soft); }
  .cta-box{ margin-top:56px; padding:28px; background:var(--panel); border:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap; }
  .cta-box p{ font-family:var(--serif); font-size:19px; }
</style>
